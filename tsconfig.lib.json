{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "dist-package/types",
    "rootDir": "src",
    "types": ["vite/client"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/index.ts",
    "src/types.ts",
    "src/AnimatedLineChart/AnimatedlineChart.tsx",
    "src/AnimatedChartAnnotated/AnimatedChartAnnotated.tsx",
    "src/BarChart/BarChart.tsx"
  ]
}
