{
  "name": "@akhil9tiet/jitter-charts",
  "private": false,
  "version": "0.1.2",
  "license": "MIT",
  "type": "module",
  "description": "Animated React charts with fixed styles and built-in motion.",
  "repository": {
    "type": "git",
    "url": "https://github.com/akhil9tiet/jitter-charts.git"
  },
  "homepage": "https://github.com/akhil9tiet/jitter-charts#readme",
  "bugs": {
    "url": "https://github.com/akhil9tiet/jitter-charts/issues"
  },
  "keywords": ["react", "charts", "d3", "animation", "visualization"],
  "files": ["dist-package", "LICENSE", "README.md"],
  "main": "./dist-package/index.cjs",
  "module": "./dist-package/index.js",
  "types": "./dist-package/types/index.d.ts",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist-package/types/index.d.ts",
      "import": "./dist-package/index.js",
      "require": "./dist-package/index.cjs"
    },
    "./style.css": "./dist-package/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "build:package": "vite build --config vite.lib.config.ts --configLoader runner && tsc -p tsconfig.lib.json",
    "lint": "eslint .",
    "preview": "vite preview --configLoader runner"
  },
  "dependencies": {
    "d3": "^7.9.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1"
  }
}
